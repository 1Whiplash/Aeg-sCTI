# --- Genel ---
ENVIRONMENT=development
DEBUG=true
READ_ONLY_MODE=true
SECRET_KEY=change_me_in_production
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
# Sadece gerçek bir ters proxy (nginx vb.) X-Forwarded-For'u kendisi
# ekliyorsa true yapın — aksi halde rate limit sahte IP'yle atlatılabilir.
TRUST_PROXY_HEADERS=false

# --- Admin girişi (whitelist yazma / FortiGate aksiyonu için) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_password
POSTGRES_DB=aegis_cti

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Ollama (Qwen 2.5) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# --- CTI Kaynak API Key'leri ---
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
MISP_URL=
MISP_API_KEY=

# --- FortiGate SOAR (Faz 1: Pasif/Standby) ---
# FORTIGATE_AUTO_BLOCK_ENABLED=true yapmadan ÖNCE: FORTIGATE_BLOCK_INTERFACE
# cihazınızın gerçek arayüz adına göre ayarlanmalı ("any" birçok kurulumda
# çalışır ama garanti değil) ve mutlaka bir test/lab FortiGate'te
# denenmeli — bu üretim güvenlik duvarınızı gerçekten etkiler.
FORTIGATE_HOST=
FORTIGATE_API_KEY=
FORTIGATE_VERIFY_SSL=true
FORTIGATE_AUTO_BLOCK_ENABLED=false
FORTIGATE_BLOCK_INTERFACE=any
FORTIGATE_ADDRESS_GROUP_NAME=AegisCTI-Blocklist
FORTIGATE_POLICY_INBOUND_NAME=AegisCTI-Block-Inbound
FORTIGATE_POLICY_OUTBOUND_NAME=AegisCTI-Block-Outbound

# --- SIEM Dışa Aktarım (Syslog/CEF, Faz 1: Pasif/Standby) ---
SIEM_EXPORT_ENABLED=false
SIEM_HOST=
SIEM_PORT=514
SIEM_PROTOCOL=udp
SIEM_ALERT_THRESHOLD=50

LOG_LEVEL=INFO
